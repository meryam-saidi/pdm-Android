<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="188dp"
    app:cardCornerRadius="8dp"
    android:padding="8dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/secondary"
    app:cardElevation="9dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/imageFood"
            android:layout_width="100dp"
            android:layout_height="160dp"
            android:src="@drawable/food"
            android:scaleType="centerCrop"
            android:layout_margin="8dp" />

        <ImageView
            android:id="@+id/menuItem"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/menu_item_icon" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_marginTop="10dp"
            tools:text="Title goes here"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textAllCaps="true"
            />

        <TextView
            android:id="@+id/tvDonor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_below="@id/tvTitle"
            android:text="Donor: "
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tvDonorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/tvDonor"
            android:layout_below="@id/tvTitle"
            tools:text="donor name"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/tvQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_below="@id/tvDonorName"
            android:text="Quantity: "
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tvQuantityAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/tvQuantity"
            android:layout_below="@id/tvDonorName"
            tools:text="quantity of Food"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_below="@id/tvQuantity"
            android:text="Description: "
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tvDescriptionAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_below="@id/tvDescription"
            tools:text="Cette interface définit les méthodes d'appel HTTP que l'application android "
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/tvExpirationDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imageFood"
            android:layout_below="@id/tvDescriptionAnswer"
            android:text="ExpirationDate: "
            android:textColor="@color/white"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tvExpirationDateAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/tvExpirationDate"
            android:layout_below="@id/tvDescriptionAnswer"
            tools:text="expirationDate"
            android:textColor="@color/white"
            />
    </RelativeLayout>

</androidx.cardview.widget.CardView>
