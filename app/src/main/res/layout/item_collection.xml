<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    android:padding="8dp"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/secondary"
    app:cardElevation="9dp">

    <RelativeLayout
        android:layout_width="389dp"
        android:layout_height="188dp"
        android:layout_gravity="center"
        android:layout_margin="16dp">

        <TextView
            android:id="@+id/firstView"
            android:layout_width="10dp"
            android:layout_height="match_parent"/>

        <TextView
            android:id="@+id/tvCollectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_toEndOf="@+id/firstView"
            android:text="Collection Details"
            android:textAllCaps="true"
            android:textColor="@color/brown"
            android:textSize="20sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvFoodType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCollectionTitle"
            android:layout_toEndOf="@+id/firstView"
            android:layout_marginBottom="3dp"
            android:text="Food Type: "
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFoodTypeAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvCollectionTitle"
            android:layout_marginBottom="3dp"
            android:layout_toEndOf="@+id/tvFoodType"
            android:textColor="@color/white"
            tools:text="food type" />

        <TextView
            android:id="@+id/tvStartDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvFoodTypeAnswer"
            android:layout_toEndOf="@+id/firstView"
            android:layout_marginBottom="3dp"
            android:text="Start Date: "
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStartDateAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvFoodTypeAnswer"
            android:layout_marginBottom="3dp"
            android:layout_toEndOf="@+id/tvStartDate"
            android:textColor="@color/white"
            tools:text="start date" />

        <TextView
            android:id="@+id/tvEndDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStartDate"
            android:layout_toEndOf="@+id/firstView"
            android:layout_marginBottom="3dp"
            android:text="End Date: "
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEndDateAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvStartDateAnswer"
            android:layout_marginBottom="3dp"
            android:layout_toEndOf="@+id/tvEndDate"
            android:textColor="@color/white"
            tools:text="end date" />

        <TextView
            android:id="@+id/tvComment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvEndDate"
            android:layout_toEndOf="@+id/firstView"
            android:layout_marginBottom="3dp"
            android:text="Comment: "
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommentAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvEndDate"
            android:layout_marginBottom="3dp"
            android:layout_toEndOf="@+id/tvComment"
            android:textColor="@color/white"
            tools:text="comment left" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@id/tvCommentAnswer"
            android:layout_marginLeft="160dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Update"
                android:textColor="@color/beige" />

            <View
                android:layout_width="10dp"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@id/btnDelete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="@color/beige"
                android:textColorLink="@color/primary" />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
